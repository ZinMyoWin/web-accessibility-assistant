NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
AUTH_API_BASE_URL=http://127.0.0.1:8000
AUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - leave blank to keep Google sign-in disabled).
# Create credentials at https://console.cloud.google.com/apis/credentials and
# set the redirect URI to ${NEXTAUTH_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret sent by the Next.js server to backend POST /auth/google.
# This must match OAUTH_PROXY_SECRET in the backend environment.
OAUTH_PROXY_SECRET=

# Optional authenticated remote MCP; leave blank to keep MCP disabled.
# See ../docs/guides/mcp-integration.md for provider setup and account linking.
# Example resource: https://audit.example.com/api/mcp (HTTP loopback in dev only).
MCP_PUBLIC_URL=
# Exact OAuth issuer identifier, preserving any trailing slash.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# Random >=32 UTF-8 bytes; match backend MCP_INTERNAL_SECRET, use a distinct secret.
MCP_INTERNAL_SECRET=
# Additional exact origins, comma-separated; canonical frontend origin is automatic.
MCP_ALLOWED_ORIGINS=
