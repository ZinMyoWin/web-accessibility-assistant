# Copy to an uncommitted root .env for Docker Compose. Replace both app secrets.
AUTH_JWT_SECRET=replace-with-a-long-random-backend-secret
AUTH_SECRET=replace-with-a-different-long-random-frontend-secret
PASSWORD_RESET_LOG_LINKS=false

# Optional existing Google sign-in and screenshot storage.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_PROXY_SECRET=
CLOUDINARY_URL=
CLOUDINARY_SCREENSHOT_FOLDER=accessaudit/issue-screenshots
CLOUDINARY_SCREENSHOT_FALLBACK=

# Remote MCP is disabled until a real OAuth provider and these values are set.
# See docs/guides/mcp-integration.md. Example resource: https://audit.example.com/api/mcp
MCP_PUBLIC_URL=
# Exact provider issuer, preserving its trailing slash if present.
MCP_OAUTH_ISSUER=
MCP_OAUTH_JWKS_URL=
# Random >=32 UTF-8 bytes, distinct from other secrets; shared frontend/backend.
MCP_INTERNAL_SECRET=
# Additional allowed exact origins, comma-separated; canonical origin is automatic.
MCP_ALLOWED_ORIGINS=
# Per-user internal operations/minute; a tool call normally consumes two.
MCP_RATE_LIMIT_PER_MINUTE=60
